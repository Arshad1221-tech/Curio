# ---------------------------------------------------------------------------
# Curio configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file - it is excluded by .gitignore.
# ---------------------------------------------------------------------------

# Runtime environment: development or production
CURIO_ENV=development

# Show detailed error tracebacks (only enable while developing)
CURIO_DEBUG=false

# Secret used to sign session cookies. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty, Curio generates a temporary key at start-up and all users are
# logged out whenever the server restarts.
CURIO_SECRET_KEY=

# SQLAlchemy database URL. Leave empty to use the default SQLite file at
# data/curio.db inside the project folder.
CURIO_DATABASE_URL=

# Session lifetime in seconds (default: 14 days)
CURIO_SESSION_MAX_AGE=1209600

# Set to true when serving Curio over HTTPS so cookies are marked Secure
CURIO_SECURE_COOKIES=false

# Timeout in seconds for calls to external metadata APIs
CURIO_HTTP_TIMEOUT=8

# --- External metadata APIs -------------------------------------------------
# TMDB (movies and TV): create a free account at https://www.themoviedb.org/
# then open Settings -> API. Provide EITHER the v3 API key OR the v4 read
# access token (the token is preferred).
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Google Books (books): works without a key at a low shared quota. For a
# personal quota create an API key in Google Cloud Console and enable the
# "Books API".
GOOGLE_BOOKS_API_KEY=

# iTunes Search API (songs and albums): no key required.
# Two-letter store country code used for search results.
ITUNES_COUNTRY=US
